<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= event.title %></title>
    <link rel="stylesheet" href="/event.css">
</head>
<body>

    <!-- Header -->
    <%- include('partials/header') %>

    <main class="event-container">
        <div class="event-details">

            <!-- Image Section -->
            <div class="event-image-container">
                <% if (event.image) { %>
                    <img src="<%= event.image %>" alt="<%= event.title %>" class="event-image">
                <% } else { %>
                    <img src="/images/default.jpg" alt="Default Event Image" class="event-image">
                <% } %>
            </div>

            <!-- Info Section -->
            <div class="event-info">
                <h1><%= event.title %></h1>
                <p><strong>Category:</strong> <%= event.category %></p>
                <p><strong>Hosted by:</strong> 
                    <% if (event.host && typeof event.host === 'object' && event.host.firstName) { %>
                        <%= event.host.firstName %>
                    <% } else { %>
                        <%= event.host %>
                    <% } %>
                </p>
                <p><strong>Date & Time:</strong> 
                    <%= new Date(event.start).toLocaleString() %> - 
                    <%= new Date(event.end).toLocaleString() %>
                </p>
                <p><strong>Location:</strong> <%= event.location %></p>
                <p><strong>Details:</strong> <%= event.details %></p>
                
                <!-- RSVP Breakdown -->
                <% if (typeof yesCount !== 'undefined' && typeof noCount !== 'undefined' && typeof maybeCount !== 'undefined') { %>
                    <p><strong>RSVPs:</strong> 
                        YES: <%= yesCount %>, 
                        NO: <%= noCount %>, 
                        MAYBE: <%= maybeCount %>
                    </p>
                <% } %>
            </div>

            <!-- Action Buttons -->
            <div class="event-actions" style="display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; margin-top: 20px;">
                <a href="/events" class="back-btn">Back to Events</a>

                <% if (currentUser && String(currentUser._id) === String(event.host)) { %>
                    <div style="display: flex; gap: 10px;">
                        <a href="/events/edit/<%= event._id %>" class="edit-btn">Edit Event</a>

                        <form action="/events/delete/<%= event._id %>?_method=DELETE" method="POST" style="display:inline;">
                            <button type="submit" class="delete-btn">Delete Event</button>
                        </form>
                    </div>
                <% } %>

                <% if (currentUser && String(currentUser._id) !== String(event.host)) { %>
                    <form action="/events/<%= event._id %>/rsvp" method="POST" style="display: flex; gap: 10px;">
                        <button type="submit" name="status" value="YES" class="rsvp-btn yes">Yes</button>
                        <button type="submit" name="status" value="NO" class="rsvp-btn no">No</button>
                        <button type="submit" name="status" value="MAYBE" class="rsvp-btn maybe">Maybe</button>
                    </form>
                <% } %>
            </div>

        </div>
    </main>

    <!-- Footer -->
    <%- include('partials/footer') %>

</body>
</html>
